# 复制本文件为 .env 并填上你的真实配置（.env 不会被提交）

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blog_system

# 用 openssl rand -hex 32 之类的方式生成一个强随机串
JWT_SECRET=please-change-me-to-a-long-random-string

PORT=3000

# Redis 缓存(可选,服务连不上时会自动降级为直通)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
